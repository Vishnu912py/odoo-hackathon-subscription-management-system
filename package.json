{
  "name": "odoo-hackathon-subscription-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Brightloop Software Subscription Management System",
  "scripts": {
    "db:validate": "python database/scripts/verify_schema_integrity.py",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=database/prisma/schema.prisma",
    "prisma:seed": "tsx database/prisma/seed.ts",
    "test:db": "tsx database/scripts/test_db_constraints.ts"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "tsx database/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
