# Copy to .env; never commit real credentials. No DB is needed for /health/live.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Set to your own PostgreSQL database. The placeholder is for local development only.
DATABASE_URL=postgresql://brightloop:change_me@localhost:5432/brightloop?schema=public

# Optional direct connection for Prisma Migrate when runtime uses a pooled URL.
# DIRECT_URL=postgresql://brightloop:change_me@localhost:5432/brightloop?schema=public

# Explicit opt-in for synthetic accounts/data in a development database only.
ALLOW_DEV_SEED=false
# Optional replacement for the documented development-only demo password.
# DEMO_PASSWORD=YourDevelopmentPassword!
# Gmail API credentials belong only on the server. Configure all five together.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=
# AUTH_EMAIL_KEY=32-byte-random-key-as-64-hex-characters
# CRON_SECRET=random-maintenance-bearer-secret
